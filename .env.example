# ─────────────────────────────────────────────────────────────
# NEXORA Realty — environment configuration
# Copy to .env.local for development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser — never put secrets in them.
# ─────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shows the demonstration ribbon and "Demo listing" labels. Set to false only once listings are real and verified.
NEXT_PUBLIC_DEMO_MODE=true

# Authentication
# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Demo staff accounts (used when DATA_BACKEND=demo). Required in production; development falls back
# to the documented defaults in README.md. Use `npm run hash-password` if you prefer bcrypt hashes.
DEMO_ADMIN_PASSWORD=
DEMO_AGENT_PASSWORD=

# Data backend: "demo" (local JSON store, no setup) or "supabase"
DATA_BACKEND=demo
# Optional location for the demo store and uploaded photos (defaults to ./.data, or /tmp on Vercel)
DEMO_DATA_DIR=

# Supabase (required when DATA_BACKEND=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security — keep it out of client code and logs.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=property-media

# Email notifications via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="NEXORA Realty <no-reply@your-domain.com>"
# Comma-separated staff inboxes that receive new-lead alerts
LEAD_NOTIFICATION_EMAIL=

# WhatsApp
# Public click-to-chat number shown on the site, digits only with country code (e.g. 9715XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# WhatsApp Business Cloud API — staff alerts for new leads (requires an approved message template)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_NOTIFY_TO=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# External CRM (any system that accepts a signed JSON webhook: HubSpot workflow, Zoho, Salesforce middleware, Zapier, Make…)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Maps — optional. Without a key the site uses an OpenStreetMap embed.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Analytics — optional, pick one
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# AI services — integration points only; see src/lib/ai/README.md
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Property inventory feed (portal or developer API) — see src/lib/integrations/inventory-feed.ts
INVENTORY_FEED_URL=
INVENTORY_FEED_TOKEN=
